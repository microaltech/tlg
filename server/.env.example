# Salin menjadi server/.env (jangan di-commit).
DOMAIN=tn.contoh.id
# Token dasbor admin: buat dengan `openssl rand -hex 24`.
ADMIN_TOKEN=
# Peringatan bila server banyak galat (Slack/Discord/Telegram-bot webhook yang menerima JSON {"text": ...}).
ALERT_WEBHOOK=
# Verifikasi pembelian Google Play (opsional; aktifkan juga baris volume di docker-compose.yml).
# IAP_PACKAGE=com.microaltech.tuannusantara
# IAP_SERVICE_ACCOUNT=/secrets/iap.json
