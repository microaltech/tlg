; Engine configuration file.

config_version=5

[application]

config/name="Top Lord Like"
config/version="0.1.0"
config/description="Prototipe game idle strategi kerajaan ala Top Lord."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Game="*res://scripts/core/game.gd"
Audio="*res://scripts/core/audio.gd"
Store="*res://scripts/core/store.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

textures/canvas_textures/default_texture_filter=3

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
