<?xml version="1.0" encoding="utf-8"?>
<!-- Widget layar beranda Tuan Nusantara: judul + tiga baris ringkasan dari game. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tlg_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tlg_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tlg_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F2C14E"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tlg_widget_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#F4E4C1"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tlg_widget_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F4E4C1"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tlg_widget_line3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#F4E4C1"
        android:textSize="13sp" />
</LinearLayout>
